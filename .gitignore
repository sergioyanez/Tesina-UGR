# ============================================================
# Datos crudos — NUNCA se versionan
# ============================================================
# La carpeta videos/ pesa ~1.9 GB y tres archivos superan los 100 MB,
# que es el límite duro de GitHub. El dataset vive en Google Drive.
videos/
clips_equinos/
frames_equinos/
dataset_equinos_videos/
processed_equinos/

# Videos y frames sueltos, estén donde estén
*.mp4
*.avi
*.mov
*.mkv
*.webm

# ============================================================
# Salidas generadas por el pipeline
# ============================================================
resultados_equinos/
modelos_equinos/
runs/
frames_alineados/

# Raíz de artefactos cuando el pipeline corre fuera de Colab (equinos.rutas).
# En Colab la raíz vive en Google Drive y no toca el repo.
# Los artefactos del pipeline se regeneran corriendo las etapas: no se versionan.
datos_equinos/*

# Salvo las anotaciones manuales. Eso NO se regenera: son posiciones que una persona marcó a
# mano, frame por frame, y perder el archivo significa volver a anotarlas. Es dato de entrada,
# no resultado. Git no puede des-ignorar un archivo si su directorio padre está excluido, de ahí
# que haya que abrir el camino carpeta por carpeta.
!datos_equinos/resultados/
datos_equinos/resultados/*
!datos_equinos/resultados/keypoints_manuales.csv
datos_equinos/resultados/*
!datos_equinos/resultados/keypoints_manuales.csv
*.pt
*.pth
*.h5
*.ckpt

# Los CSV son reproducibles ejecutando el notebook
inventario_videos.csv
inventario_clips.csv
dataset_frames.csv

# ============================================================
# Backups y temporales
# ============================================================
*.bak
*.ipynb.bak
.ipynb_checkpoints/
*.tmp
*~

# ============================================================
# Python
# ============================================================
__pycache__/
*.py[cod]
.venv/
venv/
env/
.Python

# ============================================================
# Sistema operativo
# ============================================================
.DS_Store
Thumbs.db
desktop.ini
# exFAT / Windows en discos externos
System Volume Information/
$RECYCLE.BIN/

# ============================================================
# Configuración local de editores e IDE
# ============================================================
# Es configuración de una máquina y de un editor, no del proyecto.
.idea/
.vscode/
